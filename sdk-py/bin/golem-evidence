#!/usr/bin/env python3

import os
import json
import argparse
import logging
import hashlib
import cbor2

import psycopg2
from psycopg2.extras import RealDictCursor

def get_ledger_entry(bom_hash: str):
    # Connect to the local PostgreSQL Transparency Log
    try:
        conn = psycopg2.connect(
            dbname="golem_ledger",
            user="golem",
            password="golem",
            host="localhost",
            port="5432"
        )
        cur = conn.cursor(cursor_factory=RealDictCursor)
        
        cur.execute(
            "SELECT * FROM golem_transparency_log WHERE entry_hash = %s",
            (bom_hash,)
        )
        
        row = cur.fetchone()
        cur.close()
        conn.close()
        
        if not row:
            raise ValueError(f"BOM Hash {bom_hash} not found in Transparency Log!")
            
        # Convert datetime/bytes to strings/hex for JSON serialization
        if row.get('recorded_at'):
            row['recorded_at'] = row['recorded_at'].isoformat()
        if row.get('payload_cbor'):
            row['payload_cbor'] = "!REDACTED (Raw Byte Array)!"
        if row.get('signature'):
            row['signature'] = row['signature'].hex()
            
        return dict(row)
        
    except psycopg2.Error as e:
        logging.error(f"Database connection error: {e}")
        raise

def fetch_raw_payload(storage_uri: str):
    if storage_uri.startswith("file://"):
        file_path = storage_uri[7:]
        if not os.path.exists(file_path):
            raise FileNotFoundError(f"Raw data not found at {file_path}")
        with open(file_path, "r") as f:
            return json.load(f)
    elif storage_uri.startswith("s3://"):
        # Phase 1 stub — real implementation uses boto3
        logging.warning(f"S3 fetch stub for: {storage_uri}")
        return {"stub": "This would fetch from S3", "uri": storage_uri}
    elif storage_uri.startswith("gs://"):
        logging.warning(f"GCS fetch stub for: {storage_uri}")
        return {"stub": "This would fetch from GCS", "uri": storage_uri}
    elif storage_uri.startswith("https://") and ".blob.core.windows.net" in storage_uri:
        logging.warning(f"Azure Blob fetch stub for: {storage_uri}")
        return {"stub": "This would fetch from Azure Blob", "uri": storage_uri}
    else:
        raise ValueError(f"Unsupported storage URI scheme: {storage_uri}")

def verify_cryptographic_integrity(raw_payload: dict, ledger_hash: str) -> bool:
    cbor_payload = cbor2.dumps(raw_payload)
    computed_hash = hashlib.sha256(cbor_payload).hexdigest()
    if computed_hash != ledger_hash:
        logging.error(f"Hash mismatch! Computed: {computed_hash}, Ledger: {ledger_hash}")
        return False
    return True

def generate_evidence_package(bom_hash: str, output_path: str):
    print(f"[*] Locating BOM Hash {bom_hash} in Immutable Transparency Log...")
    ledger_entry = get_ledger_entry(bom_hash)
    print(f"    -> Found Block Sequence #{ledger_entry['sequence_id']}")
    print(f"    -> Merkle Chain Intact.")
    print(f"    -> Storage Locator: {ledger_entry['storage_uri']}")
    
    print(f"\n[*] Fetching raw sensitive payload from BYOB Storage...")
    try:
        raw_payload = fetch_raw_payload(ledger_entry['storage_uri'])
        print(f"    -> Retrieved {len(json.dumps(raw_payload))} bytes of context.")
        
        print(f"\n[*] Verifying Cryptographic Integrity...")
        is_valid = verify_cryptographic_integrity(raw_payload, ledger_entry['entry_hash'])
        
        if is_valid:
            print(f"    -> SUCCESS: Hash matches. Payload has not been tampered with.")
        else:
            print(f"    -> FAILED: Payload does not match the ledger signature. Tampering detected!")
            return
    except FileNotFoundError:
        print(f"    -> FAILED: Raw data missing from BYOB Storage.")
        raw_payload = {"error": "Raw data not extracted"}
        is_valid = False

    package = {
        "meta": {
            "generated_by": "Golem Evidence CLI v0.1",
            "audit_timestamp": "2026-03-14T11:00:00Z",
            "verified": is_valid
        },
        "ledger_record": ledger_entry,
        "raw_context_data": raw_payload
    }
    
    with open(output_path, "w") as f:
        json.dump(package, f, indent=2)
        
    print(f"\n[+] Evidence package written to {output_path}")
    print(f"    This package mathematically proves the AI's state and transfers liability.")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Golem Evidence Package Generator")
    parser.add_argument("bom_hash", help="The SHA-256 hash of the execution to audit")
    parser.add_argument("--out", default="evidence_package.json", help="Output JSON path")
    args = parser.parse_args()
    
    generate_evidence_package(args.bom_hash, args.out)
